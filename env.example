# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/scolink_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here-must-be-at-least-32-characters"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here-must-be-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV="development"
TRUST_PROXY=false

# CORS Configuration
CORS_ORIGIN="https://app.scolink.ink,https://scolink.ink,https://www.scolink.ink,http://localhost:8080,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=5

# Super Admin Credentials (for seeding)
SUPER_ADMIN_EMAIL="admin@admin.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# Email Service
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="replace-with-smtp-password"
EMAIL_FROM="no-reply@example.com"
SMTP_SECURE=false

# Paddle
PADDLE_WEBHOOK_SECRET="replace-with-paddle-webhook-secret"
PADDLE_CLIENT_TOKEN="replace-with-paddle-client-token"
PADDLE_PRODUCT_ID="replace-with-paddle-product-id"
PADDLE_PRICE_PRO="replace-with-pro-price-id"
PADDLE_PRICE_PREMIUM="replace-with-premium-price-id"
PADDLE_PRICE_LIFETIME="replace-with-lifetime-price-id"

# Seed-only credentials
SEED_CENTER_ADMIN_PASSWORD="replace-with-seed-admin-password"

# Test Database (for testing)
TEST_DATABASE_URL="mysql://test:test@localhost:3306/scolink_test"
